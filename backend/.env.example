# Required: API key for the LLM provider (4Geeks / LiteLLM gateway).
LLM_API_KEY=

# Optional: base URL of the LLM gateway. Defaults to https://llm.4geeks.ai.
LLM_BASE_URL=

# Optional: model identifier used for instruction routing.
# Default: downtown-miami/groq/llama-3.1-8b-instant
LLM_MODEL=

# Optional: comma-separated list of allowed CORS origins.
# Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
